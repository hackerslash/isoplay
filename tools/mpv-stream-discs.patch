         keyfile = mp_get_user_path(NULL, s->global, b->opts->keyfile);
-    int opened = bd_open_disc(bd, device_tmp, keyfile);
+    int opened;
+    if (strstr(device, "://")) {
+        // A network disc image can only be read through libbluray's block callback
+        // (bd_open_disc takes a local path). This is how VLC plays remote ISOs.
+        b->under = stream_create(device, STREAM_READ | STREAM_ORIGIN_DIRECT, s->cancel, s->global);
+        if (!b->under) {
+            MP_ERR(s, "Couldn't open the Blu-ray image stream: %s\n", device);
+            opened = 0;
+        } else {
+            MP_INFO(s, "Opening Blu-ray image from a stream: %s\n", device);
+            opened = bd_open_stream(bd, b, bluray_read_blocks);
+        }
+    } else {
+        opened = bd_open_disc(bd, device_tmp, keyfile);
+    }
     talloc_free(keyfile);
     talloc_free(device_tmp);
     if (!opened) {
