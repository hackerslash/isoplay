     mp_mutex_lock(&bluray_log_lock);
     // If we created the global log, unset it.
     if (bluray_log == priv->bluray_log)
         bluray_log = NULL;
     mp_mutex_unlock(&bluray_log_lock);
     mp_mutex_destroy(&priv->overlay_lock);
+    mp_mutex_destroy(&priv->read_lock);
 }
 
 static const char *bd_event_str(uint32_t event)
@@ -1448,6 +1457,26 @@ static bool select_initial_title(stream_t *s, int title_guess) {
     return true;
 }
 
+// libbluray's stream reader: absolute LBA and block count, 2048-byte LBAs, 1 on success.
+static int bluray_read_blocks(void *handle, void *buf, int lba, int num_blocks)
+{
+    struct bluray_priv_s *b = handle;
+    int64_t pos = (int64_t)lba * 2048;
+    size_t len = (size_t)num_blocks * 2048, got = 0;
+    bool ok;
+
+    mp_mutex_lock(&b->read_lock);
+    ok = stream_seek(b->under, pos);
+    while (ok && got < len) {
+        int n = stream_read(b->under, (char *)buf + got, len - got);
+        if (n <= 0)
+            break;
+        got += n;
+    }
+    mp_mutex_unlock(&b->read_lock);
+    return ok && got == len;
+}
